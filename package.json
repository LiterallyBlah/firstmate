{
  "name": "@gpambrozio/paseo-firstmate",
  "version": "0.4.0",
  "private": true,
  "description": "Paseo plugin: talk to one first mate agent that runs a crew of Paseo agents in their own worktrees, with a live board of the crew",
  "license": "MIT",
  "homepage": "https://github.com/gpambrozio/paseo-plugins/tree/main/firstmate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpambrozio/paseo-plugins.git",
    "directory": "firstmate"
  },
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "templates/",
    "vendor/",
    "art/",
    "CHANGELOG.md",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "report:attention": "node --experimental-strip-types server/attention-report.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint:deck-packs": "vitest run shared/deck-setting.test.ts test/deck-settings.test.ts test/office-draft.test.ts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.0",
    "@getpaseo/protocol": "0.11.0",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "pixi.js": "8.22.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "4.6.6"
  },
  "dependencies": {
    "@getpaseo/client": "0.11.0"
  }
}
